<Window x:Class="Knipser.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Knipser" Width="1200" Height="760" MinWidth="1100" MinHeight="420"
        Background="#1B1B1B" Foreground="#EEEEEE" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Background" Value="#363636"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#4A4A4A"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#1E88E5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="#363636" CornerRadius="4" Padding="10,5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#4A4A4A"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="b" Property="Background" Value="#1E88E5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonBtn" TargetType="Button">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="7,4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3C3C3C"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Background" Value="#1E88E5"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonTool" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#EEEEEE"/>
            <Setter Property="Margin" Value="1,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" CornerRadius="3" Padding="7,4" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#3C3C3C"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#484848"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RibbonTab" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#BBBBBB"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" Padding="14,6,14,5" BorderThickness="0,0,0,2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FFFFFF"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                <Setter TargetName="b" Property="Background" Value="#2B2B2B"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="#1E88E5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#202020">
            <StackPanel x:Name="Ribbon"/>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="#262626" Padding="10,4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <TextBlock x:Name="PosText" Foreground="#AAAAAA" FontSize="12" Width="90" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SizeText" Foreground="#AAAAAA" FontSize="12" Width="110" VerticalAlignment="Center"/>
                    <Slider x:Name="ZoomSlider" Width="130" Minimum="10" Maximum="400" VerticalAlignment="Center" ToolTip="Zoom"/>
                    <TextBlock x:Name="ZoomText" Foreground="#AAAAAA" FontSize="12" Width="52" TextAlignment="Right" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="Status" Foreground="#AAAAAA" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
        <Grid>
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                      Background="#121212" PreviewMouseWheel="Scroller_Wheel">
            <Grid x:Name="Host" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1"/>
                </Grid.LayoutTransform>
                <Canvas x:Name="Art" ClipToBounds="True" Focusable="True" Background="Transparent"
                        MouseLeftButtonDown="Art_Down" MouseMove="Art_Move" MouseLeftButtonUp="Art_Up"/>
                <Canvas x:Name="Sel"/>
            </Grid>
        </ScrollViewer>
        <Canvas x:Name="LoupeLayer" IsHitTestVisible="False"/>
        <StackPanel x:Name="CropBar" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"/>
        </Grid>
    </DockPanel>
</Window>
