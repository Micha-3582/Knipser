<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>Knipser</AssemblyName>
    <RootNamespace>Knipser</RootNamespace>
    <NoWarn>WFAC010</NoWarn>
    <ApplicationIcon>Knipser.ico</ApplicationIcon>
    <Version>1.21.0</Version>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Knipser.ico" />
  </ItemGroup>
</Project>






